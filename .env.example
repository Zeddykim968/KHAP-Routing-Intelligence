# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── PostgreSQL + PostGIS ──────────────────────────────────────────────────────
# Local (WSL / Docker):
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/khap
# Remote (e.g. Neon, Railway, Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── OSRM Routing Engine ───────────────────────────────────────────────────────
# Local WSL instance (recommended for production accuracy):
# OSRM_URL=http://localhost:5000
# Public OSRM demo server (works out of the box, rate-limited):
OSRM_URL=http://router.project-osrm.org

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Create frontend/.env.local with:
# VITE_API_URL=http://localhost:8000
