# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Defaults to local SQLite (backend/db.sqlite3) — works out of the box.
# Set DATABASE_URL to use PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/khap

# ── Django ────────────────────────────────────────────────────────────────────
# Secret key (an insecure default is used in development)
# DJANGO_SECRET_KEY=change-me
# Debug mode (default: true)
# DJANGO_DEBUG=true
# Comma-separated allowed hosts (dev default: *)
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed by CORS (dev default: *)
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── OSRM Routing Engine ───────────────────────────────────────────────────────
# Local instance (recommended for production accuracy):
# OSRM_URL=http://localhost:5000
# Public OSRM demo server (works out of the box, rate-limited):
OSRM_URL=http://router.project-osrm.org

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Next.js rewrites /api/* to the Django backend automatically.
# Override in frontend/.env.local if the backend runs elsewhere:
# NEXT_PUBLIC_API_URL=http://localhost:8000
